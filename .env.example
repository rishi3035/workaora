# Workaora settings template.
#
# 1. Copy this file and name the copy  .env.local
# 2. Fill in the values in .env.local (never in this file).
# 3. .env.local stays on your computer. Git is set up to ignore it.
#
# .env.local must only ever hold keys for the DEVELOPMENT Supabase project.
# Production keys are entered in the hosting provider's settings, never on this computer.
#
# Find the values in the Supabase dashboard: Project Settings -> API Keys (and Data API for the URL).

# The project's address, e.g. https://abcdefghijklmnop.supabase.co
# Copy it only up to .supabase.co . The dashboard may show it with /rest/v1/ on the end; leave that part out.
NEXT_PUBLIC_SUPABASE_URL=

# The publishable key. Starts with sb_publishable_ . Safe to be public.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# The SECRET key. Starts with sb_secret_ . It bypasses all database security.
# Never share it, never paste it into chat, and never give it a NEXT_PUBLIC_ name.
SUPABASE_SECRET_KEY=
